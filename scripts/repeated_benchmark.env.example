# Copy this file outside version control and set FLOWLOT_CONFIG to its path.
FLOWLOT_STAGE2=/data/stage2/stage2_analytics.h5
FLOWLOT_DATASET=BLAST110
FLOWLOT_CELL_COUNT=1000
FLOWLOT_PREPROCESS=common12
FLOWLOT_EMBEDDING=patient0_sinkhorn_disp
FLOWLOT_RESULTS=/data/results/repeated_classification

# Use the intersection to guarantee every classifier sees exactly the same IDs.
FLOWLOT_PATIENT_POLICY=intersection
FLOWLOT_TUBES=P1,P2,P3,P4
FLOWLOT_TRAIN_PER_CLASS=2,4,6,8
FLOWLOT_REPEATS=10
FLOWLOT_TEST_SIZE=0.5
FLOWLOT_SEED=42

# XGBoost requires: pip install -e '.[xgboost]'
FLOWLOT_MODELS=logistic,linear_svm,random_forest,extra_trees,nsc,nsc_energy,xgboost,flowsom,cellcnn,attention_mil,cytoset,dgcnn,pointnet2
FLOWLOT_AGGREGATIONS=single,early_mean,late_soft
FLOWLOT_EPOCHS=50
FLOWLOT_BATCH_SIZE=8
FLOWLOT_MAX_CELLS=2048
FLOWLOT_DEVICE=cuda

# Patient-level stratified bootstrap over repeat-averaged test probabilities.
FLOWLOT_BOOTSTRAP_ITERATIONS=2000
FLOWLOT_CONFIDENCE_LEVEL=0.95
FLOWLOT_BOOTSTRAP_SEED=42

# Environment and scheduler settings vary by cluster.
FLOWLOT_ENV_ACTIVATE=/shared/project/.venv/bin/activate
FLOWLOT_PYTHON=python3
FLOWLOT_CPUS=4
FLOWLOT_MAX_CONCURRENT=20
FLOWLOT_SBATCH_ARGS="--partition=gpu --gres=gpu:1 --cpus-per-task=4 --mem=32G --time=24:00:00"

# Local smoke-test parallelism used by: hpc_repeated_benchmark.sh local
FLOWLOT_LOCAL_JOBS=1
